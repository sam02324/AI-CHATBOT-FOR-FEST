# Copy this file to .env.local and fill in the values. Never share or commit .env.local.
ANTHROPIC_API_KEY=
# From the API keys page in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Postgres connection string from Neon or Supabase.
DATABASE_URL=
# Optional. How many AI requests the whole app can make per day. The default is 2000.
AI_DAILY_LIMIT=
